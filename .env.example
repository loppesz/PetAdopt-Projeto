# Copie este arquivo para .env e preencha com seus valores.
# O arquivo .env NÃO deve ser enviado ao GitHub (já está no .gitignore).

# Chave usada para assinar a sessão do Flask.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# URL de conexão do banco. Se vazio, usa instance/petadopt.db (SQLite local).
# Exemplo: DATABASE_URL=sqlite:///C:/caminho/para/petadopt.db
DATABASE_URL=
